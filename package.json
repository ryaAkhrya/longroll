{
  "name": "longroll",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @longroll/web",
    "dev:realtime": "npm run dev -w @longroll/realtime",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @longroll/web"
  },
  "engines": {
    "node": ">=22.9"
  }
}
