    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@longroll/shared": "*",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
