# Nama variabel & nilai contoh LOKAL. Jangan isi rahasia di file ini.
# Salin bagian web ke apps/web/.env.local dan bagian realtime ke apps/realtime/.env (atau export di shell).

# --- apps/web ---
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Origin object storage S3-compatible (CSP img-src/connect-src untuk signed URL frame). Kosong = storage lokal via realtime.
NEXT_PUBLIC_STORAGE_ORIGIN=

# --- apps/realtime ---
PORT=4000
# Origin web yang diizinkan (CORS + cek Origin di API & WebSocket). Pisahkan dengan koma.
ALLOWED_ORIGINS=http://localhost:3000
# URL WebSocket publik yang dikirim ke klien.
PUBLIC_WS_URL=ws://localhost:4000/ws

# PostgreSQL (Neon) untuk state room sementara. Kosong = store memori (dev saja, hilang saat restart).
# Format Neon: postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full
# JANGAN commit nilai aslinya. Taruh di apps/realtime/.env (sudah di-.gitignore) atau secret manager.
# Skema WAJIB diterapkan manual dulu (db/migrations); service hanya memeriksa versinya saat start.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Hanya untuk keadaan darurat: izinkan store memori saat NODE_ENV=production (TIDAK disarankan).
ALLOW_MEMORY_STORE=

# Opsional, MANUAL: database/branch khusus uji untuk test/integration/postgres.test.ts.
LONGROLL_TEST_DATABASE_URL=

# Object storage sementara (frame custom P05; foto P06+). Privat; akses klien hanya lewat signed URL.
# Pilihan: (1) S3-compatible (WAJIB di produksi): Neon Object Storage / R2 / MinIO;
#          (2) folder lokal (dev): STORAGE_LOCAL_DIR; (3) kosong semua = memori proses (dev saja).
STORAGE_LOCAL_DIR=
# Rahasia HMAC signed URL storage lokal. Kosong = acak per proses.
STORAGE_SIGNING_SECRET=
# Origin HTTP publik service realtime (signed URL storage lokal). Kosong = diturunkan dari PUBLIC_WS_URL.
PUBLIC_HTTP_URL=
# S3-compatible. Bucket PRIVAT. JANGAN commit kredensial; isi di apps/realtime/.env / secret manager.
# Neon Object Storage (branch development): endpoint per branch, region ap-southeast-1, path-style.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Cookie kredensial (DEC-082). Default Secure=true (Chrome/Firefox menerima di http://localhost).
# Safari di http://localhost mungkin menolak cookie Secure: set false HANYA untuk dev lokal.
COOKIE_SECURE=
# Kosong = host-only (disarankan; cookie milik host realtime saja).
COOKIE_DOMAIN=

# Lifecycle (07, DEC-020/021/052)
ROOM_GRACE_PERIOD_SECONDS=120
PARTICIPANT_HOLD_SECONDS=60
# Kosong = tanpa batas umur room (DEC-052 OPEN). Jangan diisi tanpa persetujuan pemilik produk.
ROOM_MAX_LIFETIME_HOURS=
# Umur cookie kredensial; diperbarui (rotasi) otomatis selama tab aktif.
CREDENTIAL_TTL_SECONDS=43200

# Salt hash IP untuk rate limit. Kosong = acak per proses (berganti saat restart).
RATE_LIMIT_SALT=
# true hanya bila service berada di belakang reverse proxy milik sendiri (X-Forwarded-For).
TRUST_PROXY=false
CLEANUP_RETRY_SECONDS=60,300,900,3600
SWEEP_INTERVAL_SECONDS=60

# --- WebRTC ICE (P03, DEC-073 OPEN: provider-neutral) ---
# Kosong = STUN publik Google default; isi daftar sendiri (dipisah koma) untuk mengganti; "none" = tanpa STUN.
STUN_URLS=
# TURN skema REST "use-auth-secret" (coturn / penyedia terkelola). Kosong = tanpa TURN (STUN saja).
# Contoh: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600

# --- Fase berikutnya ---
GOOGLE_CLIENT_ID=
